#!/bin/zsh
# leaf [path ...]: opens notes or folders in Leaf, like `nvim path`. A missing .md path is created first.
set -eu
app=/Applications/Leaf.app
[[ -d $app ]] || { echo "leaf: $app not found (run Tools/build.sh)" >&2; exit 1; }

(( $# == 0 )) && exec open -a "$app"

paths=()
for arg in "$@"; do
  p=${arg:A}
  if [[ ! -e $p ]]; then
    case $p in
      *.md|*.markdown|*.adoc) mkdir -p "${p:h}"; : > "$p" ;;
      *) echo "leaf: no such file: $arg" >&2; exit 1 ;;
    esac
  fi
  paths+=("$p")
done
exec open -a "$app" "${paths[@]}"
